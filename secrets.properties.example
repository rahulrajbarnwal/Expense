# Copy this file to `secrets.properties` and fill in your own values.
# `secrets.properties` is git-ignored and must never be committed.
#
# WEB_CLIENT_ID is the OAuth 2.0 *Web application* client ID from your Firebase project.
# Find it in google-services.json as the oauth_client entry with "client_type": 3, or in
# Firebase Console -> Project settings -> General -> Your apps -> Web client ID.
WEB_CLIENT_ID=000000000000-YOUR_WEB_CLIENT.apps.googleusercontent.com
